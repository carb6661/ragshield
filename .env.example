RAGSHIELD_DATABASE_URL=sqlite:///./ragshield.db
RAGSHIELD_CORS_ORIGINS=http://localhost:5173
RAGSHIELD_ENABLE_NETWORK_TARGETS=false
RAGSHIELD_HTTP_TARGET_ALLOWLIST=
RAGSHIELD_ALLOW_PRIVATE_TARGETS=false
RAGSHIELD_ALLOW_INSECURE_HTTP=false
RAGSHIELD_HTTP_TIMEOUT_SECONDS=10
RAGSHIELD_MAX_RESPONSE_BYTES=1000000
